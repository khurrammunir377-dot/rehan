{
  "functions": {
    "api/index.py": {
      "includeFiles": "{frontend/**,public/**,posters/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__orig_path=/api/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__orig_path=/api/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/posters/:path*",
      "destination": "/public/posters/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "/public/:path*"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}
